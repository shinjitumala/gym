{
  "db_name": "SQLite",
  "query": "\nSELECT e.id AS \"id!\", e.name, e.note\nFROM exercise e\nJOIN (\n    SELECT ts.exercise AS ex, MAX(julianday(ts.date)) AS last\n    FROM training_set ts\n    JOIN session s ON s.id = ts.session\n    WHERE s.place = ?1\n    GROUP BY ts.exercise\n) x ON x.ex = e.id\nORDER BY x.last DESC, e.id\n",
